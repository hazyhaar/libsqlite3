+/*
+** modernc.org/sqlite: SEH emulation for the ccgo build.
+**
+** Go has no __try/__except, but the Go runtime turns the same hardware fault
+** (EXCEPTION_IN_PAGE_ERROR on Windows, SIGBUS/SIGSEGV elsewhere) into a
+** recoverable panic while debug.SetPanicOnFault() is in effect for the
+** goroutine. modernc_seh_try(), implemented in Go (seh.go, next to the
+** transpiled library), runs xBody(pWal, pArg) with that guard armed. If a
+** fault inside the wal-index mapping is caught it returns xOnFault(pWal), or
+** SQLITE_IOERR_IN_PAGE when xOnFault is NULL; otherwise it returns whatever
+** xBody() returned. Every SEH_TRY{...}SEH_EXCEPT(...) block of this file is
+** therefore rewritten under __CCGO__ as a call through walSehTry(), with the
+** protected statements moved into a static thunk function. SEH_TRY itself is
+** deliberately left undefined here, so that a block introduced by a future
+** SQLite upgrade fails to transpile instead of silently running unguarded.
+**
+** modernc_seh_inject() is the counterpart of sehInjectFault(): the Go side
+** decides, by a countdown set from tests, whether to raise a simulated
+** fault at this point.
+**
+** See https://gitlab.com/cznic/sqlite/-/issues/221
+*/
+int modernc_seh_try(Wal *pWal, int (*xBody)(Wal*,void*), void *pArg, int (*xOnFault)(Wal*));
+void modernc_seh_inject(Wal *pWal);
+static int walAssertLockmask(Wal *pWal);
+
+/* Simulate a memory-mapping fault in the -shm file for testing purposes */
+# define SEH_INJECT_FAULT modernc_seh_inject(pWal)
+
+/*
+** Run xBody(pWal, pArg) under the fault guard. Mirrors what SEH_TRY{...}
+** SEH_EXCEPT(X) does in the MSVC build, including the debug-only bookkeeping.
+*/
+static int walSehTry(
+  Wal *pWal,
+  int (*xBody)(Wal*,void*),
+  void *pArg,
+  int (*xOnFault)(Wal*)
+){
+  int rc;
+  assert( walAssertLockmask(pWal) && pWal->nSehTry==0 );
+  VVA_ONLY(pWal->nSehTry++);
+  rc = modernc_seh_try(pWal, xBody, pArg, xOnFault);
+  VVA_ONLY(pWal->nSehTry--);
+  assert( pWal->nSehTry==0 );
+  return rc;
+}
