+  int eMode2;                     /* Mode to pass to walCheckpoint() */
+  int (*xBusy2)(void*);           /* Busy handler for eMode2 */
+  void *pBusyArg;                 /* Context argument for xBusyHandler */
+  sqlite3 *db;                    /* Check this handle's interrupt flag */
+  int sync_flags;                 /* Flags to sync db file with (or 0) */
+  int nBuf;                       /* Size of temporary buffer */
+  u8 *zBuf;                       /* Temporary buffer to use */
+  int *pnLog;                     /* OUT: Number of frames in WAL */
+  int *pnCkpt;                    /* OUT: Number of backfilled frames in WAL */
+};
+/* The body of the SEH_TRY{...} block of sqlite3WalCheckpoint(), see there. */
+static int walSehCheckpoint(Wal *pWal, void *p){
+  WalSehCheckpoint *a = (WalSehCheckpoint*)p;
+  int rc = a->rc;
+  if( rc==SQLITE_OK ){
+    /* For a passive checkpoint, do not re-enable blocking locks after
+    ** reading the wal-index header. A passive checkpoint should not block
+    ** or invoke the busy handler. The only lock such a checkpoint may
+    ** attempt to obtain is a lock on a read-slot, and it should give up
+    ** immediately and do a partial checkpoint if it cannot obtain it. */
+    walDisableBlocking(pWal);
+    rc = walIndexReadHdr(pWal, a->pisChanged);
+    if( a->eMode2>SQLITE_CHECKPOINT_PASSIVE ) (void)walEnableBlocking(pWal);
+    if( *a->pisChanged && pWal->pDbFd->pMethods->iVersion>=3 ){
+      sqlite3OsUnfetch(pWal->pDbFd, 0, 0);
+    }
+  }
+
+  /* Copy data from the log to the database file. */
+  if( rc==SQLITE_OK ){
+    sqlite3FaultSim(660);
+    if( pWal->hdr.mxFrame && walPagesize(pWal)!=a->nBuf ){
+      rc = SQLITE_CORRUPT_BKPT;
+    }else if( a->eMode2!=SQLITE_CHECKPOINT_NOOP ){
+      rc = walCheckpoint(pWal, a->db, a->eMode2, a->xBusy2, a->pBusyArg,
+                         a->sync_flags, a->zBuf);
+    }
+
+    /* If no error occurred, set the output variables. */
+    if( rc==SQLITE_OK || rc==SQLITE_BUSY ){
+      if( a->pnLog ) *a->pnLog = (int)pWal->hdr.mxFrame;
+      SEH_INJECT_FAULT;
+      if( a->pnCkpt ) *a->pnCkpt = (int)(walCkptInfo(pWal)->nBackfill);
+    }
+  }
+  return rc;
+}
+#endif
