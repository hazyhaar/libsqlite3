--- src/os_unix.c
+++ src/os_unix.c
@@ -990,6 +990,44 @@
 #endif /* SQLITE_LOCK_TRACE */
 
 /*
+** Enable Open File Description (OFD) locking on Linux with automatic
+** one-time fallback to standard POSIX locking if EINVAL is returned.
+** See: https://gitlab.com/cznic/sqlite/-/issues/255
+*/
+#if defined(F_OFD_SETLK)
+static volatile int ofdSupported = 1;
+static int osFcntlOfd(int fd, int cmd, void *arg){
+  if( ofdSupported ){
+    int ofdCmd = cmd;
+    if( cmd==F_SETLK ) ofdCmd = F_OFD_SETLK;
+    else if( cmd==F_SETLKW ) ofdCmd = F_OFD_SETLKW;
+    else if( cmd==F_GETLK ) ofdCmd = F_OFD_GETLK;
+    if( ofdCmd!=cmd ){
+      struct flock *pLock = (struct flock *)arg;
+      pLock->l_pid = 0; /* Required by Linux kernel for F_OFD_* commands */
+      int rc = osFcntl(fd, ofdCmd, arg);
+      if( rc!=(-1) || errno!=EINVAL ){
+        return rc;
+      }
+      ofdSupported = 0;
+    }
+  }
+  return osFcntl(fd, cmd, arg);
+}
+/*
+** The descriptor through which the kernel locks on pFile's inode are held.
+** With OFD locks every lock of the inode must go through one open file
+** description (pInode->hLock); with POSIX locks the fd does not matter,
+** so use pFile->h as upstream does.
+*/
+# define unixLockFd(pFile) \
+    ((ofdSupported && (pFile)->pInode->hLock) ? (pFile)->pInode->hLock : (pFile)->h)
+#else
+#define osFcntlOfd osFcntl
+#define unixLockFd(pFile) ((pFile)->h)
+#endif
+
+/*
 ** Retry ftruncate() calls that fail due to EINTR
 **
 ** All calls to ftruncate() within this file should be made through
@@ -1327,6 +1365,8 @@
   int nLock;                        /* Number of outstanding file locks */
   unsigned char eFileLock;          /* One of SHARED_LOCK, RESERVED_LOCK etc. */
   unsigned char bProcessLock;       /* An exclusive process lock is held */
+  unsigned char bLockIsReadOnly;    /* True if hLock is an O_RDONLY descriptor */
+  int hLock;                        /* File descriptor holding the OFD lock */
   UnixUnusedFd *pUnused;            /* Unused file descriptors to close */
   int nRef;                       /* Number of pointers to this structure */
   unixShmNode *pShmNode;          /* Shared memory associated with this inode */
@@ -1699,7 +1739,7 @@
     lock.l_start = RESERVED_BYTE;
     lock.l_len = 1;
     lock.l_type = F_WRLCK;
-    if( osFcntl(pFile->h, F_GETLK, &lock) ){
+    if( osFcntlOfd(unixLockFd(pFile), F_GETLK, &lock) ){
       rc = SQLITE_IOERR_CHECKRESERVEDLOCK;
       storeLastErrno(pFile, errno);
     } else if( lock.l_type!=F_UNLCK ){
@@ -1804,6 +1844,7 @@
   unixInodeInfo *pInode = pFile->pInode;
   assert( pInode!=0 );
   assert( sqlite3_mutex_held(pInode->pLockMutex) );
+  int h = unixLockFd(pFile);
   if( (pFile->ctrlFlags & (UNIXFILE_EXCL|UNIXFILE_RDONLY))==UNIXFILE_EXCL ){
     if( pInode->bProcessLock==0 ){
       struct flock lock;
@@ -1812,7 +1853,7 @@
       lock.l_start = SHARED_FIRST;
       lock.l_len = SHARED_SIZE;
       lock.l_type = F_WRLCK;
-      rc = osSetPosixAdvisoryLock(pFile->h, &lock, pFile);
+      rc = osFcntlOfd(h, F_SETLK, &lock);
       if( rc<0 ) return rc;
       pInode->bProcessLock = 1;
       pInode->nLock++;
@@ -1824,10 +1865,10 @@
     if( pFile->bBlockOnConnect && pLock->l_type==F_RDLCK
      && pLock->l_start==SHARED_FIRST && pLock->l_len==SHARED_SIZE
     ){
-      rc = osFcntl(pFile->h, F_SETLKW, pLock);
+      rc = osFcntlOfd(h, F_SETLKW, pLock);
     }else
 #endif
-    rc = osSetPosixAdvisoryLock(pFile->h, pLock, pFile);
+    rc = osFcntlOfd(h, F_SETLK, pLock);
   }
   return rc;
 }
@@ -1959,6 +2000,26 @@
     assert( eFileLock==SHARED_LOCK );
     assert( pFile->eFileLock==0 );
     assert( pInode->nShared>0 );
+
+#if defined(F_OFD_SETLK)
+    /* If designated locking fd is read-only, migrate to this read-write fd */
+    if( ofdSupported && pInode->bLockIsReadOnly
+     && (pFile->ctrlFlags & UNIXFILE_RDONLY)==0
+    ){
+      lock.l_type = F_RDLCK;
+      lock.l_whence = SEEK_SET;
+      lock.l_start = SHARED_FIRST;
+      lock.l_len = SHARED_SIZE;
+      if( osFcntlOfd(pFile->h, F_SETLK, &lock)==0 ){
+        lock.l_type = F_UNLCK;
+        lock.l_start = lock.l_len = 0L;
+        osFcntlOfd(pInode->hLock, F_SETLK, &lock);
+        pInode->hLock = pFile->h;
+        pInode->bLockIsReadOnly = 0;
+      }
+    }
+#endif
+
     pFile->eFileLock = SHARED_LOCK;
     pInode->nShared++;
     pInode->nLock++;
@@ -2026,6 +2087,11 @@
       pFile->eFileLock = SHARED_LOCK;
       pInode->nLock++;
       pInode->nShared = 1;
+      if( pInode->hLock==0 ){
+        /* First lock on this inode: pFile->h now holds the kernel locks */
+        pInode->hLock = pFile->h;
+        pInode->bLockIsReadOnly = (pFile->ctrlFlags & UNIXFILE_RDONLY)!=0;
+      }
     }
   }else if( eFileLock==EXCLUSIVE_LOCK && pInode->nShared>1 ){
     /* We are trying for an exclusive lock but another thread in this
@@ -2263,7 +2329,11 @@
     */
     pInode->nLock--;
     assert( pInode->nLock>=0 );
-    if( pInode->nLock==0 ) closePendingFds(pFile);
+    if( pInode->nLock==0 ){
+      pInode->hLock = 0;
+      pInode->bLockIsReadOnly = 0;
+      closePendingFds(pFile);
+    }
   }
 
 end_unlock:
